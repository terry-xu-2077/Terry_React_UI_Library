{
  "name": "terry-react-ui-library",
  "version": "0.2.0",
  "description": "Reusable React/TypeScript UI components and base theme.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./base": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base/theme.css": "./dist/base/theme.css",
    "./base/theme-system.css": "./dist/base/theme-system.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json && node scripts/finalize-library.mjs",
    "build:showcase": "vite build",
    "build": "npm run build:lib && npm run build:showcase",
    "prepare": "npm run build:lib",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
